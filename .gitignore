# =============================================================================
# react-native-izooto — root .gitignore
#
# Scope: JS/TS library (src/), native library code (android/, ios/) and the
#        demo app (example/) for BOTH Android and iOS.
#
# Rules of thumb:
#   * Never commit machine-specific config, build output or dependency caches.
#   * DO commit lockfiles (yarn.lock / Podfile.lock), the Gradle wrapper
#     (gradle/wrapper/**), debug.keystore and the prebuilt libs/*.aar.
# =============================================================================


# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?
Thumbs.db
ehthumbs.db
desktop.ini


# -----------------------------------------------------------------------------
# IDEs / editors
# -----------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Eclipse / Buildship (generated by Gradle tooling)
.settings/
.project
.classpath
.factorypath
bin/

# VS Code (keep shared recommendations only)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.sample

# Vim / Sublime / Emacs
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
\#*\#
.\#*


# -----------------------------------------------------------------------------
# Node / JavaScript / TypeScript
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Caches
.npm/
.eslintcache
.stylelintcache
.cache/
.turbo/
*.tsbuildinfo

# Tests / coverage
coverage/
.nyc_output/
junit.xml

# Build / publish output of the library itself
lib/
dist/
build/
typings/generated/
*.tgz

# Yarn (Berry). Lockfile + .yarnrc.yml are committed, caches are not.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Never ignore lockfiles — they must stay reproducible
!yarn.lock
!package-lock.json
!pnpm-lock.yaml


# -----------------------------------------------------------------------------
# React Native / Metro / Expo
# -----------------------------------------------------------------------------
.metro-cache/
metro-cache/
.metro-health-check*
.haste_map*
.expo/
.expo-shared/
*.jsbundle
*.bundle.map
.tmp/
*.tmp


# -----------------------------------------------------------------------------
# Environment & secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
secrets.properties
keystore.properties
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
service-account*.json

# Firebase client configs: uncomment if your app must not ship them publicly.
# The demo app in example/ intentionally tracks google-services.json so it
# builds out of the box.
# google-services.json
# GoogleService-Info.plist


# =============================================================================
# ANDROID
# =============================================================================

# Gradle caches / daemon / local state
.gradle/
gradle-app.setting
.gradletasknamecache
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Machine-specific SDK / NDK paths
local.properties

# Build output
build/
out/
release/
captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.apk
*.aab
*.aar.d
*.ap_
*.dex
*.class
*.hprof
output.json
output-metadata.json
lint-results*.html
lint-results*.xml

# Keep the prebuilt iZooto Android SDK artifacts that ship with this package
!android/libs/
!android/libs/*.aar
!example/android/reactnative/*.aar

# Stray Gradle "user home" folders created when Gradle is run with
# GRADLE_USER_HOME pointing at the project directory. Pure cache, never commit.
daemon/
native/
wrapper/dists/
**/android/wrapper/
**/android/daemon/
**/android/native/

# Navigation editor / misc Android Studio artifacts
.navigation/
freeline/
freeline_project_description.json


# =============================================================================
# iOS / Xcode
# =============================================================================

# User-specific Xcode state (per-developer, must never be shared)
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode build output
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.o
*.lo
*.la
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager (resolved file kept intentionally for apps)
.swiftpm/xcuserdata/
.build/

# Machine-specific node path used by the RN Xcode build scripts
.xcode.env.local

# CocoaPods — Podfile.lock IS committed so pod versions stay reproducible
Pods/
!Podfile
!Podfile.lock

# Pod-generated workspace of the demo app (recreated by `pod install`)
example/ios/*.xcworkspace/

# Carthage
Carthage/Build/

# Ruby / Bundler / Fastlane
.bundle/
vendor/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output/
**/fastlane/README.md


# -----------------------------------------------------------------------------
# Patches / merge leftovers
# -----------------------------------------------------------------------------
*.orig
*.rej
*.patch
*.diff
*.bak
