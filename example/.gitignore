# =============================================================================
# example/ — React Native demo app (RN 0.76)
# The repository root .gitignore already covers most cases; this file keeps the
# demo app self-contained if it is ever extracted into its own project.
# =============================================================================

# OSX
.DS_Store

# -----------------------------------------------------------------------------
# Xcode / iOS
# -----------------------------------------------------------------------------
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
*.dSYM.zip
*.dSYM

# Machine-specific node path for the RN Xcode build phases
ios/.xcode.env.local

# CocoaPods (Podfile.lock is committed on purpose)
ios/Pods/
ios/*.xcworkspace/

# -----------------------------------------------------------------------------
# Android / Gradle / IntelliJ
# -----------------------------------------------------------------------------
.gradle/
local.properties
.idea/
*.iml
android/app/build/
android/build/
android/.cxx/
android/.kotlin/
android/captures/
android/app/release/
*.apk
*.aab
*.hprof

# Stray Gradle user-home caches sometimes generated inside android/
android/daemon/
android/native/
android/wrapper/

# Keep the Gradle wrapper and the debug keystore
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties
*.keystore
!android/app/debug.keystore

# -----------------------------------------------------------------------------
# Node / Yarn / Metro
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
.eslintcache
coverage/

# Yarn Berry: keep yarn.lock + .yarnrc.yml, drop caches and local state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Metro / Expo
.metro-health-check*
.metro-cache/
.expo/
.expo-shared/

# -----------------------------------------------------------------------------
# BUCK
# -----------------------------------------------------------------------------
buck-out/
\.buckd/

# -----------------------------------------------------------------------------
# Fastlane
# -----------------------------------------------------------------------------
*/fastlane/report.xml
*/fastlane/Preview.html
*/fastlane/screenshots
*/fastlane/test_output

# -----------------------------------------------------------------------------
# Bundle artifacts / env
# -----------------------------------------------------------------------------
*.jsbundle
.env
.env.*
!.env.example

# Ruby
vendor/bundle/
.bundle/
